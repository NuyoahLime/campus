{
  "name": "campus-guinness-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "e2e": "playwright test",
    "e2e:production": "playwright test --config playwright.production.config.ts",
    "e2e:artifact-guard": "node e2e/support/verify-artifacts.mjs",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:startup-cleanup": "npx tsx e2e/support/startup-cleanup-verification.ts",
    "e2e:trace-guard": "node e2e/support/verify-trace-off.mjs",
    "e2e:process-tree": "npx tsx e2e/support/process-tree-cleanup-verification.ts"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^10.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.20.0",
    "tsx": "^4.20.6",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1",
    "vue-eslint-parser": "^10.2.0"
  }
}
