# Public DNS name routed to the production server. Do not include a URL path.
CAMPUS_DOMAIN=campus.example.com
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL database and application role. Replace every placeholder.
DB_NAME=replace_with_database_name
DB_USERNAME=replace_with_database_username
DB_PASSWORD=replace_with_a_strong_database_password

# One-time first administrator bootstrap. Disable use after the first successful run.
BOOTSTRAP_ADMIN_USERNAME=replace_with_initial_admin_username
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_initial_admin_password
